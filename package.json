{
  "name": "@joutio/client",
  "version": "10.0.0",
  "description": "Domaine client partagé de Joutio (web, mobile) : logique métier, lectures et hooks TanStack Query, sans DOM ni plateforme.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/joutio/joutio-client.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./game": {
      "types": "./dist/features/game/index.d.ts",
      "import": "./dist/features/game/index.js",
      "default": "./dist/features/game/index.js"
    },
    "./rooms": {
      "types": "./dist/features/rooms/index.d.ts",
      "import": "./dist/features/rooms/index.js",
      "default": "./dist/features/rooms/index.js"
    },
    "./authoring": {
      "types": "./dist/features/authoring/index.d.ts",
      "import": "./dist/features/authoring/index.js",
      "default": "./dist/features/authoring/index.js"
    },
    "./profile": {
      "types": "./dist/features/profile/index.d.ts",
      "import": "./dist/features/profile/index.js",
      "default": "./dist/features/profile/index.js"
    },
    "./me": {
      "types": "./dist/features/me/index.d.ts",
      "import": "./dist/features/me/index.js",
      "default": "./dist/features/me/index.js"
    },
    "./home": {
      "types": "./dist/features/home/index.d.ts",
      "import": "./dist/features/home/index.js",
      "default": "./dist/features/home/index.js"
    },
    "./topics": {
      "types": "./dist/features/topics/index.d.ts",
      "import": "./dist/features/topics/index.js",
      "default": "./dist/features/topics/index.js"
    },
    "./search": {
      "types": "./dist/features/search/index.d.ts",
      "import": "./dist/features/search/index.js",
      "default": "./dist/features/search/index.js"
    },
    "./social": {
      "types": "./dist/features/social/index.d.ts",
      "import": "./dist/features/social/index.js",
      "default": "./dist/features/social/index.js"
    },
    "./notifications": {
      "types": "./dist/features/notifications/index.d.ts",
      "import": "./dist/features/notifications/index.js",
      "default": "./dist/features/notifications/index.js"
    },
    "./premium": {
      "types": "./dist/features/premium/index.d.ts",
      "import": "./dist/features/premium/index.js",
      "default": "./dist/features/premium/index.js"
    },
    "./onboarding": {
      "types": "./dist/features/onboarding/index.d.ts",
      "import": "./dist/features/onboarding/index.js",
      "default": "./dist/features/onboarding/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js",
      "default": "./dist/sync/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./core/types": {
      "types": "./dist/core/types/index.d.ts",
      "import": "./dist/core/types/index.js",
      "default": "./dist/core/types/index.js"
    },
    "./core/geo": {
      "types": "./dist/core/geo/index.d.ts",
      "import": "./dist/core/geo/index.js",
      "default": "./dist/core/geo/index.js"
    },
    "./core/share": {
      "types": "./dist/core/share/index.d.ts",
      "import": "./dist/core/share/index.js",
      "default": "./dist/core/share/index.js"
    },
    "./core/i18n": {
      "types": "./dist/core/i18n/index.d.ts",
      "import": "./dist/core/i18n/index.js",
      "default": "./dist/core/i18n/index.js"
    },
    "./core/query": {
      "types": "./dist/core/query/index.d.ts",
      "import": "./dist/core/query/index.js",
      "default": "./dist/core/query/index.js"
    },
    "./core/realtime": {
      "types": "./dist/core/realtime/index.d.ts",
      "import": "./dist/core/realtime/index.js",
      "default": "./dist/core/realtime/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tanstack/eslint-plugin-query": "^5.0.0",
    "@tanstack/query-core": "^5.108.0",
    "@tanstack/react-query": "^5.90.5",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^10",
    "jsdom": "^26.0.0",
    "prettier": "^3.10.1",
    "react": "^19.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.5",
    "react": ">=18",
    "zod": "^4.6.7"
  }
}
